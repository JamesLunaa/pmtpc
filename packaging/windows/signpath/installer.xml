<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (paste into the SignPath project; slug: installer).
  Input: the GitHub artifact containing the Inno Setup installer, built from the already-signed exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file path="pmtpc-setup-${version}.exe" product-name="Phone Mic to PC" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
